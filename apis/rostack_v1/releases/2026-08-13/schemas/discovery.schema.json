{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.pmh.codes/apis/rostack_v1/releases/2026-08-13/schemas/discovery.schema.json",
  "title": "rostack_v1 discovery document",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "implementation", "endpoints", "authentication", "capabilities", "errors", "resources"],
  "properties": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "rostack"},
        "version": {"const": "rostack_v1"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "api_version", "documentation_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "api_version": {"type": "string", "minLength": 1},
        "documentation_url": {"type": "string", "format": "uri"}
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "json_api", "websocket"],
      "properties": {
        "discovery": {"type": "string", "format": "uri", "pattern": "^https://"},
        "json_api": {"type": "string", "format": "uri", "pattern": "^https://"},
        "websocket": {"type": "string", "format": "uri", "pattern": "^wss://"}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "permissions"],
      "properties": {
        "discovery_public": {"type": "boolean", "default": true},
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/oauth2Authentication"},
              {"$ref": "#/$defs/sharedTokenAuthentication"}
            ]
          }
        },
        "permissions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"},
          "patternProperties": {"^": {"type": "string", "minLength": 1}},
          "unevaluatedProperties": false
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filter_operators", "max_page_size", "websocket"],
      "properties": {
        "filter_operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "nin", "contains", "starts_with", "ends_with", "exists"]}
        },
        "max_page_size": {"type": "integer", "minimum": 1},
        "websocket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_encodings", "extensions", "authentication_timeout_ms", "heartbeat_interval_ms", "heartbeat_timeout_ms", "reconnect_min_delay_ms", "reconnect_max_delay_ms", "discovery_refresh_after_ms"],
          "properties": {
            "event_encodings": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "json"},
              "items": {"enum": ["json", "compact-json"]}
            },
            "extensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["permessage-deflate"]}
            },
            "authentication_timeout_ms": {"type": "integer", "minimum": 1000},
            "heartbeat_interval_ms": {"type": "integer", "minimum": 1000},
            "heartbeat_timeout_ms": {"type": "integer", "minimum": 1000},
            "reconnect_min_delay_ms": {"type": "integer", "minimum": 100},
            "reconnect_max_delay_ms": {"type": "integer", "minimum": 1000},
            "discovery_refresh_after_ms": {"type": "integer", "minimum": 1000}
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "websocket"],
      "properties": {
        "http": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpErrorDeclaration"}
        },
        "websocket": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/websocketErrorDeclaration"}
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resource"}
    },
    "alternate_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["api_version", "discovery_url"],
        "properties": {
          "api_version": {"type": "string", "minLength": 1},
          "discovery_url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    }
  },
  "$defs": {
    "httpProblemType": {
      "enum": [
        "https://spec.pmh.codes/problems/invalid-request",
        "https://spec.pmh.codes/problems/invalid-filter",
        "https://spec.pmh.codes/problems/unsupported-filter",
        "https://spec.pmh.codes/problems/invalid-sort",
        "https://spec.pmh.codes/problems/invalid-fields",
        "https://spec.pmh.codes/problems/invalid-cursor",
        "https://spec.pmh.codes/problems/authentication-required",
        "https://spec.pmh.codes/problems/permission-denied",
        "https://spec.pmh.codes/problems/resource-not-found",
        "https://spec.pmh.codes/problems/method-not-allowed",
        "https://spec.pmh.codes/problems/representation-not-acceptable",
        "https://spec.pmh.codes/problems/resource-gone",
        "https://spec.pmh.codes/problems/rate-limited",
        "https://spec.pmh.codes/problems/internal-error",
        "https://spec.pmh.codes/problems/service-unavailable"
      ]
    },
    "httpErrorDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operations"],
      "properties": {
        "type": {"$ref": "#/$defs/httpProblemType"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["discovery", "list", "get"]}
        }
      }
    },
    "websocketErrorCode": {
      "enum": [
        "invalid_message",
        "authentication_failed",
        "reauthentication_identity_mismatch",
        "permission_denied",
        "permission_revoked",
        "resource_not_found",
        "unsupported_event_type",
        "unsupported_filter",
        "unsupported_encoding",
        "subscription_id_conflict",
        "cursor_scope_mismatch",
        "cursor_unavailable",
        "rate_limited",
        "internal_error",
        "service_unavailable"
      ]
    },
    "websocketErrorDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "operations"],
      "properties": {
        "code": {"$ref": "#/$defs/websocketErrorCode"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["authenticate", "subscribe", "subscription", "session"]}
        }
      }
    },
    "oauth2Authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "authorization_server_metadata"],
      "properties": {
        "type": {"const": "oauth2"},
        "authorization_server_metadata": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "sharedTokenAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "http_authorization_scheme", "provisioning"],
      "properties": {
        "type": {"const": "shared_token"},
        "http_authorization_scheme": {"const": "Rostack-Token"},
        "provisioning": {"const": "out_of_band"},
        "description": {"type": "string"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "collection_url", "item_url_template", "representations", "events", "filtering", "read_permissions", "subscribe_permissions"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "description": {"type": "string"},
        "collection_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "item_url_template": {"type": "string", "pattern": "^https://.*\\{id\\}"},
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/representation"}
        },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/eventDescriptor"}
        },
        "event_filtering": {"type": "boolean", "default": false},
        "filtering": {"$ref": "#/$defs/filtering"},
        "read_permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "subscribe_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "eventDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_url", "schema_dialect", "state_transition"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "schema_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "schema_dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "description": {"type": "string"},
        "state_transition": {"enum": ["create", "update", "delete"]},
        "tombstone": {"type": "boolean", "default": false}
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "schema_url", "schema_dialect"],
      "properties": {
        "media_type": {"type": "string", "pattern": "^[^/ ]+/[^/ ]+$"},
        "schema_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "schema_dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "description": {"type": "string"}
      }
    },
    "filtering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterable_fields", "sortable_fields"],
      "properties": {
        "filterable_fields": {
          "type": "object",
          "patternProperties": {
            "^/": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "nin", "contains", "starts_with", "ends_with", "exists"]}
            }
          },
          "unevaluatedProperties": false
        },
        "sortable_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        }
      }
    }
  }
}
